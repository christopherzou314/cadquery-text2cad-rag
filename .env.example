# OpenAI-compatible chat completions endpoint.
# Keep real keys out of git.
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional experiment telemetry. Prices are per 1,000,000 tokens.
# Leave prices unset when unknown; estimated cost will be null, not zero.
LLM_INPUT_COST_PER_1M_TOKENS=
LLM_OUTPUT_COST_PER_1M_TOKENS=
LLM_COST_CURRENCY=CNY

# Qwen3.7 enables thinking by default; set false for lower latency and cost.
LLM_ENABLE_THINKING=false

# Optional: interpreter that has cadquery installed.
CADQUERY_PYTHON=/path/to/your/cadquery/python
